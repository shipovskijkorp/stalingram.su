[Unit]
Description=Stalingram Django application
After=network.target

[Service]
Type=simple
User=stalingram
Group=www-data
WorkingDirectory=/opt/stalingram
EnvironmentFile=/opt/stalingram/.env
ExecStart=/opt/stalingram/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 60
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
